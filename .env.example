# Copy this to .env.local for local testing (vercel dev picks it up),
# and also add both as Environment Variables in the Vercel project
# dashboard (Settings → Environment Variables) before deploying —
# vercel.com never reads .env.local from your repo.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret
